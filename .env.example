# MPDO .env.example — copy to .env and fill in real values. Never commit .env.
# Server
PORT=3000
NODE_ENV=development
# Set COOKIE_SECURE=true only when serving over HTTPS (production).
COOKIE_SECURE=false
# Set CORS_ORIGIN only for cross-origin deployments (same-origin default: unset).
# CORS_ORIGIN=https://permits.buenavista.gov.ph

# MySQL 8 / XAMPP (server/server/db.js reads DB_*; backend currently uses these only)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mpdo_db

# GIS (Leaflet + OSM defaults; override map center without code changes)
MAP_CENTER_LAT=9.7740
MAP_CENTER_LNG=125.5764
MAP_DEFAULT_ZOOM=13

# Notifications — development outbox is used when these are unset
# SMTP_EMAIL_* unset => mail is written to dev outbox, never claimed delivered
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMS provider unset => SMS written to dev outbox, never claimed delivered
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER=

# Document uploads
UPLOAD_DIR=./storage/uploads
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png
